# Node environment
NODE_ENV=development

# API server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Postgres (used from Phase 1 onward)
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Signs the auth JWT — required (min 16 chars). Generate one, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-long-random-secret

# Groq LLM — get a free key at https://console.groq.com
# Leave empty to use the mock LLM (also what tests/CI use)
GROQ_API_KEY=

# Web → API: same-origin path; Next proxies /api/* to the API so the auth cookie stays first-party.
NEXT_PUBLIC_API_URL=/api
# Where the Next server proxies /api/* to (override in containers, e.g. http://api:4000).
API_PROXY_TARGET=http://localhost:4000
