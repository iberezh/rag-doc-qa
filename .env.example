# Node environment
NODE_ENV=development

# API server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Postgres (used from Phase 1 onward)
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Signs the auth JWT — required (min 16 chars). Generate one, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-long-random-secret

# Groq LLM — get a free key at https://console.groq.com
# Leave empty to use the mock LLM (also what tests/CI use)
GROQ_API_KEY=

# Web → API: same-origin path; Next proxies /api/* to the API so the auth cookie stays first-party.
NEXT_PUBLIC_API_URL=/api
# Where the Next server proxies /api/* to (override in containers, e.g. http://api:4000).
API_PROXY_TARGET=http://localhost:4000

# Canonical site URL for landing-page canonical/OG tags + sitemap (no trailing slash).
# Use your https domain in production; defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public key of the bot to embed live on the landing page. Leave empty to show a static mock.
NEXT_PUBLIC_DEMO_BOT_KEY=

# Stripe billing (test mode). Leave STRIPE_SECRET_KEY empty to run upgrades in mock mode.
STRIPE_SECRET_KEY=
# Price IDs (price_...) — created by `pnpm --filter api stripe:setup`, not set by hand.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# From `stripe listen --forward-to localhost:4000/api/billing/webhook`.
STRIPE_WEBHOOK_SECRET=
