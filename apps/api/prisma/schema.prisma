// pgvector note: the `vector` extension is enabled in the initial migration SQL
// (CREATE EXTENSION) and the `embedding` column uses the Unsupported("vector(384)")
// type. Vector reads/writes go through raw SQL in the repository.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum Plan {
  FREE
  STARTER
  PRO
}

enum MessageRole {
  USER
  ASSISTANT
}

model Account {
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  plan             Plan           @default(FREE)
  stripeCustomerId String?        @unique @map("stripe_customer_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  users            User[]
  bots             Bot[]
  documents        Document[]
  usageCounters    UsageCounter[]

  @@map("accounts")
}

model UsageCounter {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  period    String // billing month, "YYYY-MM"
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([accountId, period])
  @@map("usage_counters")
}

model Bot {
  id             String     @id @default(uuid()) @db.Uuid
  accountId      String     @map("account_id") @db.Uuid
  account        Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String
  publicKey      String     @unique @map("public_key")
  allowedDomains String[]   @default([]) @map("allowed_domains")
  greeting       String     @default("Hi! Ask me anything about our docs.")
  color          String     @default("#c0492c")
  showBadge      Boolean        @default(true) @map("show_badge")
  createdAt      DateTime       @default(now()) @map("created_at")
  documents      Document[]
  conversations  Conversation[]

  @@index([accountId])
  @@map("bots")
}

model Conversation {
  id           String    @id @default(uuid()) @db.Uuid
  botId        String    @map("bot_id") @db.Uuid
  bot          Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  visitorEmail String?   @map("visitor_email")
  createdAt    DateTime  @default(now()) @map("created_at")
  messages     Message[]

  @@index([botId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  citations      Json         @default("[]")
  // Only meaningful for ASSISTANT messages; null on USER turns.
  answered       Boolean?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@map("users")
}

model Document {
  id          String         @id @default(uuid()) @db.Uuid
  accountId   String         @map("account_id") @db.Uuid
  account     Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  botId       String         @map("bot_id") @db.Uuid
  bot         Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  filename    String
  contentType String         @map("content_type")
  status      DocumentStatus @default(PENDING)
  createdAt   DateTime       @default(now()) @map("created_at")
  chunks      Chunk[]

  @@index([accountId])
  @@index([botId])
  @@map("documents")
}

model Chunk {
  id         String                      @id @default(uuid()) @db.Uuid
  documentId String                      @map("document_id") @db.Uuid
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index      Int                         @map("chunk_index")
  content    String
  embedding  Unsupported("vector(384)")?
  createdAt  DateTime                    @default(now()) @map("created_at")

  @@index([documentId])
  @@map("chunks")
}
