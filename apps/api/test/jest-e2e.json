  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@iconify/utils$": "<rootDir>/stubs/iconify-utils.ts",
    "^@iconify-json/solar/icons.json$": "<rootDir>/stubs/solar-icons.json"
  }
}
